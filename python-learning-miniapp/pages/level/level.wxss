page {
  background: #FFFFFF;
}

.page {
  min-height: 100vh;
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
}

.close {
  width: 56rpx;
  font-size: 32rpx;
  color: #B0B0B0;
}

.bar {
  flex: 1;
  height: 16rpx;
  background: #EFEFEF;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.bar-fill {
  height: 100%;
  background: #58CC02;
  border-radius: 10rpx;
  transition: width 0.25s ease;
}

.counter {
  font-size: 24rpx;
  color: #9A9A9A;
  min-width: 64rpx;
  text-align: right;
}

.state {
  padding: 160rpx 60rpx;
  text-align: center;
  color: #8A8A8A;
  font-size: 26rpx;
}

.state-emoji {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.state-text {
  margin-bottom: 28rpx;
  line-height: 1.6;
}

.retry-btn {
  display: inline-block;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: #58CC02;
  color: #FFFFFF;
  font-size: 26rpx;
}

.content {
  padding: 20rpx 40rpx 40rpx;
}

.qtype {
  display: inline-block;
  font-size: 22rpx;
  color: #58A000;
  background: #F0FAE6;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.stem {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.6;
  margin-top: 24rpx;
  margin-bottom: 40rpx;
}

.option {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
  border: 3rpx solid #E8E8E8;
  border-radius: 22rpx;
  background: #FFFFFF;
}

.option.selected {
  border-color: #58CC02;
  background: #F7FDF1;
}

.option.correct {
  border-color: #58CC02;
  background: #F1FBE7;
}

.option.wrong {
  border-color: #FF6B6B;
  background: #FFF5F5;
}

.letter {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid #E0E0E0;
  color: #9A9A9A;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.option.selected .letter,
.option.correct .letter {
  border-color: #58CC02;
  background: #58CC02;
  color: #FFFFFF;
}

.option.wrong .letter {
  border-color: #FF6B6B;
  background: #FF6B6B;
  color: #FFFFFF;
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.5;
  word-break: break-all;
}

.feedback {
  margin-top: 32rpx;
  border-radius: 24rpx;
  padding: 28rpx;
}

.feedback.ok {
  background: #F1FBE7;
  border: 2rpx solid #CFF0B0;
}

.feedback.bad {
  background: #FFF5F5;
  border: 2rpx solid #FFD2D2;
}

.fb-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.feedback.ok .fb-title {
  color: #3E8E00;
}

.feedback.bad .fb-title {
  color: #D93636;
}

.fb-line {
  font-size: 26rpx;
  color: #5B5B5B;
}

.fb-exp {
  font-size: 24rpx;
  color: #7A7A7A;
  line-height: 1.7;
  margin-top: 14rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F2F2F2;
}

.btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #58CC02;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.btn-hover {
  background: #4CB300;
}

.btn.disabled {
  background: #E8E8E8;
  color: #B5B5B5;
}
