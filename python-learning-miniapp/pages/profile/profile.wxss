.page {
  padding: 28rpx 32rpx 40rpx;
}

/* ===== 头部 ===== */
.hero {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx 28rpx;
}

/* 头像 + 头像框：环、头像、等级角标三层叠在一起 */
.av-box {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  margin-right: 26rpx;
  flex-shrink: 0;
}

.av-ring {
  position: absolute;
  left: -8rpx;
  top: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border: 6rpx solid #B87333;
  border-radius: 50%;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.09);
  transition: border-color 0.25s ease;
}

.avatar {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  right: 6rpx;
  bottom: 6rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--sk-hero-from, #58CC02) 0%, var(--sk-hero-to, #37A000) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 58rpx;
  overflow: hidden;
}

/* 等级角标：压在头像底部，一眼看到等级 */
.av-lv {
  position: absolute;
  left: 50%;
  bottom: -10rpx;
  transform: translateX(-50%);
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  border: 3rpx solid #FFFFFF;
  color: #FFFFFF;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1.3;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15);
}

.av-frame-emoji {
  position: absolute;
  right: -6rpx;
  top: -6rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: var(--sk-card, #FFFFFF);
  border: 2rpx solid var(--sk-line, #F0F0F0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--sk-text, #2F2F2F);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hero-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 6rpx;
}

.tag-title {
  font-size: 21rpx;
  font-weight: 800;
  color: #4A4A4A;
  background: #F2F4F6;
  border-radius: 8rpx;
  padding: 3rpx 10rpx;
}

.tag-frame {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: var(--sk-muted, #9A9A9A);
}

/* 经验条 */
.exp-line {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.exp-bar {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--sk-track, #EFEFEF);
  overflow: hidden;
}

.exp-fill {
  height: 100%;
  border-radius: 6rpx;
  background: var(--sk-primary, #58CC02);
  transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

.exp-num {
  margin-left: 10rpx;
  font-size: 19rpx;
  color: var(--sk-muted, #9A9A9A);
  flex-shrink: 0;
}

.exp-hint {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: var(--sk-muted, #A8A8A8);
}

.tier-hint {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: 18rpx;
}

.tier-name {
  font-weight: 800;
  margin-right: 6rpx;
}

.tier-text {
  color: var(--sk-muted, #9A9A9A);
}

/* ===== 头像框收藏 ===== */
.frames-card {
  margin-bottom: 22rpx;
  padding: 26rpx 24rpx 18rpx;
  background: var(--sk-card, #FFFFFF);
  border-radius: 32rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.045);
}

.fc-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.fc-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--sk-text, #2F2F2F);
}

.fc-sub {
  font-size: 20rpx;
  color: var(--sk-muted, #A8A8A8);
}

.frame-grid {
  display: flex;
  flex-wrap: wrap;
}

/* 每行四个（8 个框刚好两行），宽度用百分比而不是 flex:1，避免最后一行被拉宽 */
.frame-item {
  width: 25%;
  padding: 10rpx 4rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 20rpx;
}

.frame-item.on {
  background: var(--sk-primary-soft, #F7FBF2);
}

.frame-item.locked {
  opacity: 0.72;
}

.frame-hover {
  background: var(--sk-track, #F5F7F9);
}

.fi-ring {
  position: relative;
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  border: 5rpx solid var(--sk-line, #DDE1E6);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--sk-card, #FFFFFF);
}

.frame-item.on .fi-ring {
  box-shadow: 0 0 0 5rpx rgba(88, 204, 2, 0.12);
}

.fi-emoji {
  font-size: 32rpx;
}

.fi-lock {
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  font-size: 18rpx;
}

.fi-name {
  margin-top: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--sk-sub, #4A4A4A);
}

.fi-state {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: var(--sk-muted, #B0B0B0);
}

.fi-state.using {
  color: var(--sk-primary, #58CC02);
  font-weight: 700;
}

/* ===== 通关进度卡 ===== */
.progress-card {
  background: var(--sk-card, #FFFFFF);
  border-radius: 32rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.045);
}

.pc-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.pc-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--sk-sub, #6E6E6E);
}

.pc-num {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--sk-primary, #58CC02);
  line-height: 1;
}

.pc-dim {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--sk-muted, #B8B8B8);
}

.pc-bar {
  height: 18rpx;
  background: var(--sk-track, #EFEFEF);
  border-radius: 10rpx;
  overflow: hidden;
  margin-top: 20rpx;
}

.pc-bar-fill {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, var(--sk-primary, #58CC02) 0%, var(--sk-primary-dark, #7ED321) 100%);
  transition: width 0.4s ease;
}

.pc-foot {
  font-size: 22rpx;
  color: var(--sk-muted, #A8A8A8);
  margin-top: 12rpx;
}

/* ===== 数据网格 ===== */
.grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  background: var(--sk-card, #FFFFFF);
  border-radius: 32rpx;
  padding: 12rpx 0;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.045);
}

.cell {
  width: 33.333%;
  padding: 22rpx 8rpx;
  text-align: center;
}

.cell-value {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--sk-text, #3C3C3C);
  line-height: 1.2;
}

.cell.accent .cell-value {
  color: var(--sk-primary, #58CC02);
}

/* 星星数用金色，和关卡地图上的星保持一致 */
.cell.gold .cell-value {
  color: #E0A800;
}

.cell-label {
  font-size: 21rpx;
  color: var(--sk-muted, #A8A8A8);
  margin-top: 8rpx;
}

/* ===== 入口条目 ===== */
.entry {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border-radius: 32rpx;
  background: var(--sk-card, #FFFFFF);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.045);
}

.entry.warn {
  background: var(--sk-card, #FFFFFF);
  border: 2rpx solid #FFE0E0;
}

.entry-hover {
  background: var(--sk-track, #F7F7F9);
}

.entry-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--sk-track, #F7F7F9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.entry-main {
  flex: 1;
  min-width: 0;
}

.entry-title {
  font-size: 29rpx;
  font-weight: 800;
}

.entry.warn .entry-title {
  color: #D93636;
}

.entry-sub {
  font-size: 22rpx;
  color: var(--sk-muted, #A8A8A8);
  margin-top: 6rpx;
  line-height: 1.4;
}

.entry-arrow {
  font-size: 34rpx;
  color: var(--sk-line, #D0D0D0);
  margin-left: 12rpx;
}

/* ===== 关于 ===== */
.about {
  margin-top: 24rpx;
  background: var(--sk-card, #FFFFFF);
  border-radius: 32rpx;
  padding: 26rpx 28rpx 8rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.045);
}

.about-title {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--sk-muted, #A8A8A8);
  margin-bottom: 8rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--sk-line, #F5F5F5);
}

.row:last-child {
  border-bottom: none;
}

.row-hover {
  opacity: 0.6;
}

.row-k {
  font-size: 26rpx;
  color: var(--sk-sub, #5B5B5B);
}

.row-v {
  font-size: 24rpx;
  color: var(--sk-muted, #A8A8A8);
  max-width: 62%;
  text-align: right;
  word-break: break-all;
}

.row-v.link {
  color: #1CB0F6;
  font-weight: 700;
}

/* ===== 皮肤：色板缩略 + 入口 ===== */
.tag-skin {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: var(--sk-muted, #9A9A9A);
}

.skin-card {
  margin-bottom: 22rpx;
  padding: 24rpx 22rpx 16rpx;
  background: var(--sk-card, #FFFFFF);
  border-radius: 32rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.045);
}

.skin-hover {
  background: var(--sk-primary-soft, #F7FBF2);
}

.sc-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sc-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--sk-text, #2F2F2F);
}

.sc-sub {
  font-size: 20rpx;
  color: var(--sk-muted, #A8A8A8);
}

.sc-row {
  display: flex;
  flex-wrap: wrap;
}

/* 7 个皮肤正好一行，不用滚动 */
.sc-item {
  width: 14.28%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 0;
}

.sc-dot {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.35);
}

.sc-item.on .sc-dot {
  box-shadow: 0 0 0 4rpx var(--sk-primary, #58CC02);
}

.sc-item.locked .sc-dot {
  opacity: 0.42;
}

.sc-lock {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.sc-name {
  margin-top: 8rpx;
  font-size: 17rpx;
  color: var(--sk-muted, #A8A8A8);
}

.sc-item.on .sc-name {
  color: var(--sk-primary, #58CC02);
  font-weight: 700;
}

.sc-more {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--sk-line, #F5F5F5);
  font-size: 21rpx;
  font-weight: 700;
  color: var(--sk-primary, #58CC02);
}

.sc-arrow {
  font-size: 28rpx;
  color: var(--sk-muted, #C8C8C8);
  font-weight: 400;
}

/* ===== 底部导航预留 ===== */
.tabbar-space {
  height: calc(150rpx + env(safe-area-inset-bottom));
}
