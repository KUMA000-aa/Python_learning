<view class="tabbar" style="{{skinStyle}}">
  <view
    class="tab {{item.key === current ? 'on' : ''}}"
    wx:for="{{tabs}}"
    wx:key="key"
    data-key="{{item.key}}"
    bindtap="onTap"
    hover-class="tab-hover"
  >
    <view class="tab-icon-wrap">
      <view class="tab-icon">{{item.icon}}</view>
      <view class="tab-badge" wx:if="{{item.key === 'review' && badge > 0}}">{{badge > 99 ? '99+' : badge}}</view>
    </view>
    <view class="tab-text">{{item.text}}</view>
  </view>
</view>
