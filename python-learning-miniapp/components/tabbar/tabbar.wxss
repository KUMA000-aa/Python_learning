.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 12rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--sk-card, rgba(255, 255, 255, 0.98));
  border-top: 2rpx solid var(--sk-line, #EFEFEF);
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.04);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 14rpx;
}

.tab-hover {
  opacity: 0.6;
}

.tab-icon-wrap {
  position: relative;
  width: 76rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  transition: background 0.2s ease, transform 0.2s ease;
}

.tab.on .tab-icon-wrap {
  background: var(--sk-primary-soft, #F0FAE6);
  transform: translateY(-2rpx);
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
  filter: grayscale(0.65);
  opacity: 0.6;
  transition: filter 0.2s ease, opacity 0.2s ease;
}

.tab.on .tab-icon {
  filter: none;
  opacity: 1;
}

.tab-text {
  font-size: 20rpx;
  color: var(--sk-muted, #B0B0B0);
  margin-top: 4rpx;
  font-weight: 600;
}

.tab.on .tab-text {
  color: var(--sk-primary, #58A000);
  font-weight: 800;
}

.tab-badge {
  position: absolute;
  top: -6rpx;
  right: 4rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #FF4B4B;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  box-shadow: 0 0 0 3rpx var(--sk-card, #FFFFFF);
}
